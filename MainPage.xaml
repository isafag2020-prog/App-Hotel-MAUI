<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.MainPage"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="30,50" Spacing="25" VerticalOptions="Center">

            <Label Text="🏨 Bem-vindo ao App Hotel" 
                   FontSize="28" 
                   TextColor="#00FF7F" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,20"/>

            <Image Source="hotel_logo.png" 
                   HeightRequest="150" 
                   HorizontalOptions="Center" />

            <Label Text="Encontre o quarto perfeito para a sua estadia com conforto e segurança." 
                   FontSize="16" 
                   TextColor="#AAAAAA" 
                   HorizontalTextAlignment="Center" />

            <Button Text="VER QUARTOS" 
                    BackgroundColor="#005eb8" 
                    TextColor="White" 
                    CornerRadius="10" 
                    HeightRequest="50" 
                    Margin="0,20,0,0"/>

            <Button x:Name="BtnSobre" 
                    Text="SOBRE O APLICATIVO" 
                    Clicked="OnSobreClicked" 
                    BackgroundColor="#333333" 
                    TextColor="White" 
                    CornerRadius="10" 
                    HeightRequest="50"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
