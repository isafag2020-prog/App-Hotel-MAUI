<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.Sobre"
             Title="App Hotel - Sobre"
             BackgroundColor="#121212">

    <VerticalStackLayout Padding="30,50" Spacing="20" VerticalOptions="Start">

        <Label Text="Informações do Sistema" 
               FontSize="24" 
               TextColor="#00FF7F" 
               FontAttributes="Bold" />

        <Frame BackgroundColor="#1E1E1E" BorderColor="#333333" CornerRadius="15" Padding="20">
            <VerticalStackLayout Spacing="15">
                <Label Text="Desenvolvedora: Bella Fagundes" TextColor="#E0E0E0" FontSize="16" />
                <Label Text="Ano de Desenvolvimento: 2026" TextColor="#E0E0E0" FontSize="16" />
                <Label Text="Empresa: BellaCode Innovations" TextColor="#E0E0E0" FontSize="16" />
                <Label Text="Versão: 1.0.0 (.NET MAUI)" TextColor="#E0E0E0" FontSize="16" />
            </VerticalStackLayout>
        </Frame>

        <Button Text="VOLTAR" 
                Clicked="OnVoltarClicked" 
                BackgroundColor="#0078D7" 
                TextColor="White" 
                CornerRadius="10" 
                HeightRequest="50" 
                Margin="0,30,0,0"/>

    </VerticalStackLayout>
</ContentPage>
